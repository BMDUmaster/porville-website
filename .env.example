APP_NAME="FarmSea Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Live subdirectory example (bmdublog.com/farmsea):
# APP_URL=https://bmdublog.com/farmsea
# APP_SUBDIRECTORY=farmsea

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farmsea_dashboard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# false = save original JPG/PNG (recommended on live hosting)
IMAGE_USE_WEBP=false

# New image format setting (replaces IMAGE_USE_WEBP)
# Options: auto | avif | webp | original
# auto = tries AVIF first, falls back to WebP, then original format
IMAGE_FORMAT=auto
IMAGE_QUALITY=85

DELIVERY_EVENING_SLOT_START=16:00
DELIVERY_LAST_SLOT_END=20:00
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=your_email@gmail.com
# Use a Google App Password (not your normal Gmail password).
MAIL_PASSWORD=your_16_character_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@farmsea.in"
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
