                                @endif
                            </div>
                            <button
                                onclick="addToCart({{ $product->id }})"
                                class="flex items-center gap-1.5 rounded-lg bg-green-600 px-3 py-2 text-[11px] font-extrabold uppercase tracking-[0.1em] text-white transition hover:bg-green-700 active:scale-95"
                            >
                                <i class="fa-solid fa-cart-shopping text-[10px]"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            @empty
                <div class="flex min-h-[220px] w-full items-center justify-center rounded-2xl border border-dashed border-slate-200 bg-white px-6 py-12 text-center text-slate-400">
                    <div>
                        <i class="fa-solid fa-star mb-3 block text-4xl opacity-30"></i>
                        <p class="text-sm font-medium">No best sellers available right now.</p>
                    </div>
                </div>
            @endforelse
        </div>

    </div>
</section>

